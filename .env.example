# ---------------------------------------------------------------------------
# Nilai di berkas ini hanya contoh dan placeholder. Rahasia yang sebenarnya
# TIDAK PERNAH masuk ke berkas terlacak git.
#
# Lokal   : salin jadi .env.local lalu isi.
# Produksi: isi lewat hPanel Hostinger, bukan lewat berkas di repo.
#           Deploy berbasis Git menyetel ulang direktori kerja, jadi .env yang
#           ditaruh di sana akan hilang pada deploy berikutnya.
#
# Variabel NEXT_PUBLIC_* dibaca SAAT PROSES MULAI dan ikut terbundel ke
# peramban. Mengubahnya di hPanel tanpa merestart aplikasi membuat nilainya
# terbaca kosong, dan tidak ada galat yang menyebutkan sebabnya.
# ---------------------------------------------------------------------------

# Domain situs. Dipakai untuk canonical, sitemap.xml, robots.txt, dan Open
# Graph. Tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=https://rajawalibara.co.id

# Pengaman indeks. Biarkan kosong atau "false" di mana pun kecuali produksi.
# Selama belum "true", robots.txt menolak semua perayap dan setiap halaman
# mengirim noindex — supaya staging tidak pernah masuk indeks Google dan
# bersaing dengan halaman asli sebagai konten duplikat.
NEXT_PUBLIC_SITE_LIVE=false

# ---------------------------------------------------------------------------
# Basis data (MySQL)
# ---------------------------------------------------------------------------
# Skemanya WAJIB "mysql://": itu yang diminta Prisma CLI dan Migrate.
# Aplikasi membongkarnya sendiri sebelum diserahkan ke driver mariadb, yang
# hanya menerima "mariadb://" (lihat lib/db/index.ts).
#
# Sandi yang mengandung @ : / ? # harus dipersenkan. Contoh: "p@ss" -> "p%40ss".
#
# connection_limit: ukuran pool. Batas koneksi serentak di shared hosting
# dihitung per akun, bukan per aplikasi — pool besar membuat aplikasi lain
# milik akun yang sama ikut ditolak. Biarkan kecil.
#
# Lokal    : mysql://root:root@localhost:3306/rajawalibara
# Hostinger: mysql://u123456_admin:sandi@localhost:3306/u123456_rajawalibara?connection_limit=5
DATABASE_URL=mysql://root@localhost:3306/rajawalibara

# ---------------------------------------------------------------------------
# Folder unggahan
# ---------------------------------------------------------------------------
# Jalur ABSOLUT, dan WAJIB di luar direktori aplikasi.
#
# Deploy berbasis Git menyetel ulang isi direktori kerja. Berkas unggahan yang
# berada di dalamnya akan hilang pada deploy berikutnya — tanpa galat, dan
# baru ketahuan saat gambar di situs berubah jadi kotak kosong. Aplikasi
# menolak jalan bila jalur ini ternyata di dalam direktori aplikasi.
#
# Lokal    : /Users/<nama>/Documents/SANTO/Rajawalibara/media
# Hostinger: /home/u123456/unggahan-rajawalibara
MEDIA_DIR=

# ---------------------------------------------------------------------------
# Sesi CMS (Better Auth)
# ---------------------------------------------------------------------------
# Kunci penandatangan sesi. Buat nilai acak sendiri:
#   openssl rand -base64 32
# Berbeda di tiap lingkungan. Kalau berubah, semua sesi yang berjalan gugur.
BETTER_AUTH_SECRET=
# Alamat asal aplikasi, dipakai untuk cookie dan pengalihan setelah masuk.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudflare Turnstile untuk formulir kontak
# ---------------------------------------------------------------------------
# Kunci situs bersifat publik dan ikut terkirim ke peramban. Rahasianya tidak.
# Hostname dipisah koma, ditulis telanjang: rajawalibara.co.id
# Skema, port, dan jalur ikut dibuang bila terlanjur ditulis.
# JANGAN memuat localhost di produksi: itu membuat token yang dibuat di mesin
# siapa pun diterima oleh server produksi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
